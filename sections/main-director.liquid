{% comment %}
  Filmography for the Directors metaobject page (templates/metaobject/directors.json):
  "Films by <director> in the archive" with film cards. The portrait and biography are shown by
  the sections director-hero and director-portrait.
  `metaobject` is the director entry being viewed.

  Products reference their director through the product metafield `custom.director`.
  Liquid has no reverse lookup, so we scan the store's products and keep those whose director
  matches this entry. Limitation: only the first 50 products of `collections.all` are scanned
  (Shopify's documented per-page limit for collection products), so films beyond that are not
  listed. Fine for a small curated catalog; a larger store would need another approach.
{% endcomment %}

{% liquid
  assign director = metaobject
  assign director_name = director.name.value
  assign film_count = 0

  # [director] in the heading becomes the director's name in red italics.
  # Escape the name on its own first, so the span tag itself is not escaped.
  assign name_escaped = director_name | escape
  assign name_html = '<span class="director-filmography__name">' | append: name_escaped | append: '</span>'
%}

{% capture film_cards %}
  {% paginate collections.all.products by 50 %}
    {% for product in collections.all.products %}
      {% if product.metafields.custom.director.value.system.id == director.system.id %}
        {% assign film_count = film_count | plus: 1 %}
        <li class="director-filmography__item">
          {% render 'film-card', product: product, sizes: '(min-width: 750px) 25vw, 50vw' %}
        </li>
      {% endif %}
    {% endfor %}
  {% endpaginate %}
{% endcapture %}

<div
  class="section section--page-width spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="director-filmography">
    {% if section.settings.heading != blank %}
      <h2 class="director-filmography__heading">
        {{- section.settings.heading | escape | replace: '[director]', name_html -}}
      </h2>
    {% endif %}

    {% if film_count > 0 %}
      <ul class="director-filmography__grid" role="list">
        {{ film_cards }}
      </ul>
    {% else %}
      <p class="director-filmography__empty">{{ section.settings.empty_text | escape }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .director-filmography {
    color: #191919;
  }

  .director-filmography__heading {
    margin-block: 0 clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3.5vw, 3.25rem);
    font-weight: var(--font-heading--weight);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .director-filmography__name {
    color: #e94b35;
    font-style: italic;
  }

  .director-filmography__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .director-filmography__item {
    min-width: 0;
  }

  .director-filmography__empty {
    margin: 0;
  }

  /* Mobile: one swipeable row instead of a grid (CSS scroll snap, no JavaScript).
     Cards are 45% wide so the next card peeks in and shows that the row can be swiped.
     Same approach as sections/product-director-films.liquid. */
  @media screen and (max-width: 749px) {
    .director-filmography__grid {
      display: flex;
      gap: 1rem;
      padding-block-end: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    .director-filmography__item {
      flex: 0 0 45%;
      scroll-snap-align: start;
    }
  }

  @media screen and (min-width: 750px) {
    .director-filmography__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .director-filmography__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 3rem 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Director filmography",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "[director] is replaced with the director's name.",
      "default": "Films by [director] in the archive"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when no films are found",
      "default": "No films by this director are currently in the archive."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
