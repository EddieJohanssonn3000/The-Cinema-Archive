{% comment %}
  Director hero for the Directors metaobject page (templates/metaobject/directors.json).
  Portrait as a tilted polaroid, the name (last word in red italics) and a facts row:
  born (metaobject field `born`), country (`country`) and the number of the director's films
  in the archive. Facts without a value are not shown.

  The film count scans the first 50 products of collections.all, like the filmography.
{% endcomment %}

{% liquid
  assign director = metaobject
  assign director_name = director.name.value
  assign portrait = director.portrait.value
  assign portrait_alt = portrait.alt | default: director_name
  assign born = director.born.value
  assign country = director.country.value

  # Split the name: everything except the last word, and the last word
  assign name_parts = director_name | split: ' '
  assign last_name = name_parts.last
  assign first_names = ''
  if name_parts.size > 1
    assign first_names = director_name | remove_last: last_name | strip
  endif

  # Count the director's films in the archive
  assign film_count = 0
  for film in collections.all.products limit: 50
    if film.metafields.custom.director.value.system.id == director.system.id
      assign film_count = film_count | plus: 1
    endif
  endfor
%}

<section class="director-hero{% if portrait == blank %} director-hero--no-portrait{% endif %}">
  {% if portrait != blank %}
    <div class="director-hero__photo">
      {{
        portrait
        | image_url: width: 1200
        | image_tag:
          class: 'director-hero__image',
          widths: '400, 600, 800, 1000, 1200',
          sizes: '(min-width: 990px) 40vw, 85vw',
          alt: portrait_alt
      }}
    </div>
  {% endif %}

  <div class="director-hero__info">
    <h1 class="director-hero__name">
      {%- if first_names != blank -%}
        <span class="director-hero__name-first">{{ first_names | escape }}</span>
      {%- endif -%}
      <span class="director-hero__name-last">{{ last_name | escape }}</span>
    </h1>

    {% if born != blank or country != blank or film_count > 0 %}
      <ul class="director-hero__facts" role="list">
        {% if born != blank %}
          <li>Born {{ born }}</li>
        {% endif %}
        {% if country != blank %}
          <li>{{ country | escape }}</li>
        {% endif %}
        {% if film_count > 0 %}
          <li>{{ film_count }} {% if film_count == 1 %}film{% else %}films{% endif %} in the archive</li>
        {% endif %}
      </ul>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .director-hero {
    --archive-ink: #191919;
    --archive-cream: #f5eedc;
    --archive-red: #e94b35;
    --archive-lilac: #c6b9e6;

    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(2.5rem, 4.5vw, 4.5rem) clamp(1.5rem, 4vw, 3.75rem);
    color: var(--archive-ink);
    background: var(--archive-lilac);
  }

  .director-hero__photo {
    justify-self: center;
    width: min(100%, 24rem);
    padding: 0.85rem 0.85rem 2rem;
    background: var(--archive-cream);
    border: 2px solid var(--archive-ink);
    box-shadow: 0.6rem 0.6rem 0 var(--archive-ink);
    transform: rotate(-1deg);
  }

  .director-hero__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1);
  }

  .director-hero__name {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 5.5vw, 5.75rem);
    font-weight: var(--font-heading--weight);
    line-height: 0.85;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }

  .director-hero__name-first {
    text-transform: uppercase;
  }

  .director-hero__name-last {
    color: var(--archive-red);
    font-style: italic;
  }

  /* Mobile: facts stacked, one per line with a thin rule between them */
  .director-hero__facts {
    display: flex;
    flex-direction: column;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
    border-block: 2px solid var(--archive-ink);
    font-family: var(--font-accent--family);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .director-hero__facts li {
    padding-block: 0.75rem;
  }

  .director-hero__facts li + li {
    border-block-start: 1px solid var(--archive-ink);
  }

  /* Wider screens: facts on one row, spread out */
  @media screen and (min-width: 750px) {
    .director-hero__facts {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.5rem 2rem;
      padding-block: 1.1rem;
    }

    .director-hero__facts li {
      padding-block: 0;
    }

    .director-hero__facts li + li {
      border-block-start: 0;
    }
  }

  @media screen and (min-width: 990px) {
    .director-hero {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 5vw, 5rem);
    }

    .director-hero--no-portrait {
      grid-template-columns: minmax(0, 1fr);
    }

    .director-hero__photo {
      transform: rotate(-2.5deg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Director hero",
  "settings": [],
  "presets": [
    {
      "name": "Director hero"
    }
  ]
}
{% endschema %}
