<section class="archive-introduction">
  <p class="archive-introduction__eyebrow">
    {{ section.settings.eyebrow }}
  </p>

  <h1 class="archive-introduction__heading">
    {{ section.settings.heading }}
  </h1>

  <div class="archive-introduction__text">
    {{ section.settings.description }}
  </div>

  {% if section.settings.link_text != blank and section.settings.link_url != blank %}
    <a
      class="archive-introduction__link"
      href="{{ section.settings.link_url }}"
    >
      {{ section.settings.link_text }}
    </a>
  {% endif %}
</section>

{% stylesheet %}
  .archive-introduction {
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .archive-introduction__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .archive-introduction__heading {
    max-width: 800px;
    margin: 1rem auto;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.05;
  }

  .archive-introduction__text {
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .archive-introduction__link {
    display: inline-block;
    padding: 0.9rem 1.5rem;
    border: 1px solid currentColor;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Archive introduction",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "THE CINEMA ARCHIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Physical films. Lasting stories."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover pre-owned films worth keeping, collecting and watching again.</p>"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Archive introduction"
    }
  ]
}
{% endschema %}
