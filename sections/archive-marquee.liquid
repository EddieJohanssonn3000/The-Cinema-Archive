{% comment %}
  Dark band with a short quote between two small archive labels.
  Every field is optional; empty fields are not rendered.
{% endcomment %}

{% liquid
  assign label_start = section.settings.label_start
  assign quote = section.settings.quote
  assign label_end = section.settings.label_end
%}

{% if label_start != blank or quote != blank or label_end != blank %}
  <section class="archive-marquee">
    {% if label_start != blank %}
      <p class="archive-marquee__label archive-marquee__label--start">{{ label_start | escape }}</p>
    {% endif %}

    {% if quote != blank %}
      <p class="archive-marquee__quote">{{ quote | escape }}</p>
    {% endif %}

    {% if label_end != blank %}
      <p class="archive-marquee__label archive-marquee__label--end">{{ label_end | escape }}</p>
    {% endif %}
  </section>
{% endif %}

{% stylesheet %}
  .archive-marquee {
    --archive-cream: #f5eedc;
    --archive-ink: #191919;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: clamp(2rem, 2rem, 3.5rem) clamp(1.5rem, 4vw, 3.75rem);
    color: var(--archive-cream);
    background: var(--archive-ink);
    text-align: center;
  }

  .archive-marquee p {
    margin: 0;
  }

  .archive-marquee__label {
    font-family: var(--font-accent--family);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .archive-marquee__quote {
    max-width: 28ch;
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 2.6vw, 2.6rem);
    line-height: 1.1;
  }

  @media screen and (min-width: 990px) {
    .archive-marquee {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 2rem;
    }

    .archive-marquee__label--start {
      grid-column: 1;
      justify-self: start;
      text-align: start;
    }

    .archive-marquee__quote {
      grid-column: 2;
    }

    .archive-marquee__label--end {
      grid-column: 3;
      justify-self: end;
      text-align: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Archive marquee",
  "settings": [
    {
      "type": "text",
      "id": "label_start",
      "label": "Left label",
      "default": "Now screening in the archive"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Every copy watched, checked and catalogued by a real film obsessive."
    },
    {
      "type": "text",
      "id": "label_end",
      "label": "Right label",
      "default": "Issue 01 / Spring"
    }
  ],
  "presets": [
    {
      "name": "Archive marquee"
    }
  ]
}
{% endschema %}
