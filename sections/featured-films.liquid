{% comment %}
  Featured films: homepage film selection.
  Intro (label, large heading, description) followed by film cards from a collection.
  The cards are snippets/film-card.liquid (shared with the director pages and
  "More from the director"); this section only sets the grid and the staggered layout.
{% endcomment %}

{% liquid
  assign label = section.settings.label
  assign heading = section.settings.heading
  assign description = section.settings.description

  # Fall back to all products when no collection is picked in the Theme Editor
  assign film_collection = section.settings.collection | default: collections.all
  assign max_films = section.settings.max_products
%}

<section class="featured-films">
  {% if label != blank %}
    <p class="featured-films__label">{{ label | escape }}</p>
  {% endif %}

  {% if heading != blank or description != blank %}
    <div class="featured-films__intro">
      {% if heading != blank %}
        <div class="featured-films__heading">{{ heading }}</div>
      {% endif %}

      {% if description != blank %}
        <div class="featured-films__description">{{ description }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% if film_collection.products.size > 0 %}
    <ul class="featured-films__grid" role="list">
      {% for product in film_collection.products limit: max_films %}
        <li class="featured-films__item">
          {% render 'film-card', product: product %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% liquid
    # The button always leads to all films; [count] is replaced with the number of products
    assign all_films_count = collections.all.products_count
    assign all_films_count_text = all_films_count | append: ''
    assign button_label = section.settings.button_label | replace: '[count]', all_films_count_text
  %}
  {% if button_label != blank and all_films_count > 0 %}
    <a class="featured-films__button" href="{{ routes.all_products_collection_url }}">
      <span>{{ button_label | escape }}</span>
      <span class="featured-films__button-arrow" aria-hidden="true">&#x2197;&#xFE0E;</span>
    </a>
  {% endif %}
</section>

{% stylesheet %}
  .featured-films {
    --archive-cream: #f5eedc;
    --archive-ink: #191919;
    --archive-blue: #3155e8;

    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3.75rem);
    color: var(--archive-ink);
    background: var(--archive-cream);
  }

  .featured-films__label {
    margin: 0 0 1.25rem;
    font-family: var(--font-accent--family);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-films__intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .featured-films__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: var(--font-heading--weight);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  .featured-films__heading p {
    margin: 0;
  }

  .featured-films__heading p:first-child {
    text-transform: uppercase;
  }

  .featured-films__heading em {
    color: var(--archive-blue);
    font-style: italic;
  }

  .featured-films__description {
    max-width: 32ch;
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    line-height: 1.3;
  }

  .featured-films__description p {
    margin: 0;
  }

  .featured-films__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1rem;
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .featured-films__item {
    min-width: 0;
  }

  .featured-films__button {
    display: flex;
    align-items: stretch;
    width: fit-content;
    margin-block-start: clamp(3rem, 6vw, 5rem);
    color: var(--archive-ink);
    background: var(--archive-cream);
    font-family: var(--font-body--family);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    border: 2px solid var(--archive-ink);
    box-shadow: 0.45rem 0.45rem 0 var(--archive-ink);
  }

  .featured-films__button span:first-child {
    padding: 1rem 1.25rem;
  }

  .featured-films__button-arrow {
    display: grid;
    width: 3.5rem;
    place-items: center;
    border-inline-start: 2px solid var(--archive-ink);
    font-size: 1.75rem;
    font-weight: 400;
  }

  @media screen and (min-width: 990px) {
    /* Wider gaps make the four cards a little narrower */
    .featured-films__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3rem clamp(2.5rem, 5vw, 5rem);
    }

    /* Staggered layout: every second card starts lower. Padding (not transform)
       so the row grows and following content is never overlapped. */
    .featured-films__item:nth-child(even) {
      padding-block-start: clamp(4rem, 8vw, 8rem);
    }

    .featured-films__intro {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
    }

    .featured-films__description {
      flex: 0 0 auto;
      padding-block-end: 0.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured films",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "01 / The edit"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Use two paragraphs. Italic text is shown in blue.",
      "default": "<p>Films worth</p><p><em>keeping.</em></p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Four singular films, rescued from the shelf and ready for their next close-up.</p>"
    },
    {
      "type": "header",
      "content": "Films"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Number of films",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Links to all films. [count] is replaced with the number of films.",
      "default": "View all [count] films"
    }
  ],
  "presets": [
    {
      "name": "Featured films"
    }
  ]
}
{% endschema %}
