{% comment %}
  Featured films: homepage film selection.
  Intro (label, large heading, description) followed by film cards from a collection.
  Cards read the product metafields custom.director (Director metaobject reference),
  custom.release_year, custom.format and custom.condition. Empty values are not rendered.
{% endcomment %}

{% liquid
  assign label = section.settings.label
  assign heading = section.settings.heading
  assign description = section.settings.description

  # Fall back to all products when no collection is picked in the Theme Editor
  assign film_collection = section.settings.collection | default: collections.all
  assign max_films = section.settings.max_products
%}

<section class="featured-films">
  {% if label != blank %}
    <p class="featured-films__label">{{ label | escape }}</p>
  {% endif %}

  {% if heading != blank or description != blank %}
    <div class="featured-films__intro">
      {% if heading != blank %}
        <div class="featured-films__heading">{{ heading }}</div>
      {% endif %}

      {% if description != blank %}
        <div class="featured-films__description">{{ description }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% if film_collection.products.size > 0 %}
    <ul class="featured-films__grid" role="list">
      {% for product in film_collection.products limit: max_films %}
        {% liquid
          assign image = product.featured_image
          assign director_name = product.metafields.custom.director.value.name.value
          assign release_year = product.metafields.custom.release_year.value
          assign film_format = product.metafields.custom.format.value
          assign film_condition = product.metafields.custom.condition.value
        %}
        <li class="film-card">
          <a class="film-card__link" href="{{ product.url }}">
            <div class="film-card__poster{% if image == blank %} film-card__poster--empty{% endif %}">
              {% if image != blank %}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    class: 'film-card__image',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    alt: image.alt | default: product.title,
                    loading: 'lazy'
                }}
              {% endif %}
            </div>

            <div class="film-card__header">
              <h3 class="film-card__title">{{ product.title | escape }}</h3>
              <span class="film-card__price">{{ product.price | money }}</span>
            </div>

            {% if director_name != blank or release_year != blank %}
              <p class="film-card__meta">
                {{- director_name | escape -}}
                {%- if director_name != blank and release_year != blank %} · {% endif -%}
                {{- release_year -}}
              </p>
            {% endif %}

            {% if film_format != blank or film_condition != blank %}
              <div class="film-card__tags">
                {% if film_format != blank %}
                  <span class="film-card__tag">{{ film_format | escape }}</span>
                {% endif %}
                {% if film_condition != blank %}
                  <span class="film-card__tag">{{ film_condition | escape }}</span>
                {% endif %}
              </div>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

{% stylesheet %}
  .featured-films {
    --archive-cream: #f5eedc;
    --archive-ink: #191919;
    --archive-blue: #3155e8;

    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3.75rem);
    color: var(--archive-ink);
    background: var(--archive-cream);
  }

  .featured-films__label {
    margin: 0 0 1.25rem;
    font-family: var(--font-accent--family);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-films__intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .featured-films__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: var(--font-heading--weight);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  .featured-films__heading p {
    margin: 0;
  }

  .featured-films__heading p:first-child {
    text-transform: uppercase;
  }

  .featured-films__heading em {
    color: var(--archive-blue);
    font-style: italic;
  }

  .featured-films__description {
    max-width: 32ch;
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    line-height: 1.3;
  }

  .featured-films__description p {
    margin: 0;
  }

  .featured-films__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1rem;
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .film-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .film-card__poster {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 2px solid var(--archive-ink);
  }

  .film-card__poster--empty {
    background: rgb(25 25 25 / 0.08);
  }

  .film-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .film-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 1rem;
  }

  .film-card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.3rem, 2vw, 2rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.05;
  }

  .film-card__price {
    flex: 0 0 auto;
    font-family: var(--font-accent--family);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .film-card__meta {
    margin: 0.4rem 0 0;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
  }

  .film-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1rem;
  }

  .film-card__tag {
    padding: 0.35em 0.6em;
    border: 1.5px solid var(--archive-ink);
    font-family: var(--font-accent--family);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  .film-card__link:hover .film-card__title,
  .film-card__link:focus-visible .film-card__title {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  @media screen and (min-width: 990px) {
    .featured-films__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3rem 2rem;
    }

    .featured-films__intro {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
    }

    .featured-films__description {
      flex: 0 0 auto;
      padding-block-end: 0.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured films",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "01 / The edit"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Use two paragraphs. Italic text is shown in blue.",
      "default": "<p>Films worth</p><p><em>keeping.</em></p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Four singular films, rescued from the shelf and ready for their next close-up.</p>"
    },
    {
      "type": "header",
      "content": "Films"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Number of films",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured films"
    }
  ]
}
{% endschema %}
