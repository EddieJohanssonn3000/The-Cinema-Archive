{% comment %}
  Archive note section: page spacing around snippets/archive-note.liquid
  (a short editorial quote between two rules, with a small label to the left).
  Every field is optional; the section is not rendered when both are empty.
{% endcomment %}

{% liquid
  assign label = section.settings.label
  assign quote = section.settings.quote
%}

{% if label != blank or quote != blank %}
  <section class="archive-note">
    {% render 'archive-note', label: label, quote: quote %}
  </section>
{% endif %}

{% stylesheet %}
  .archive-note {
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.75rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Archive note",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Archive note 04"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Look beyond the familiar. The best film on the shelf may be the one you have never heard of."
    }
  ],
  "presets": [
    {
      "name": "Archive note"
    }
  ]
}
{% endschema %}
