{% comment %}
  Director focus: highlights one entry of the Directors metaobject on the homepage.
  Name, portrait, link and the start of the biography all come from the chosen entry.
  The last word of the name is set in red italics (e.g. "AGNÈS Varda").
{% endcomment %}

{% liquid
  assign director = section.settings.director

  if director != blank
    assign director_name = director.name.value
    assign portrait = director.portrait.value
    assign portrait_alt = portrait.alt | default: director_name

    # Split the name: everything except the last word, and the last word
    assign name_parts = director_name | split: ' '
    assign last_name = name_parts.last
    assign first_names = ''
    if name_parts.size > 1
      assign first_names = director_name | remove_last: last_name | strip
    endif

    # Plain-text start of the rich text biography
    assign excerpt = director.biography | metafield_text | truncatewords: section.settings.excerpt_words
  endif
%}

{% if director != blank %}
  <section class="director-focus">
    {% if section.settings.number != blank %}
      <p class="director-focus__number" aria-hidden="true">{{ section.settings.number | escape }}</p>
    {% endif %}

    <div class="director-focus__content">
      {% if section.settings.label != blank %}
        <p class="director-focus__label">{{ section.settings.label | escape }}</p>
      {% endif %}

      <h2 class="director-focus__name">
        {%- if first_names != blank -%}
          <span class="director-focus__name-first">{{ first_names | escape }}</span>
        {%- endif -%}
        <span class="director-focus__name-last">{{ last_name | escape }}</span>
      </h2>

      {% if excerpt != blank %}
        <p class="director-focus__excerpt">{{ excerpt }}</p>
      {% endif %}

      {% if section.settings.button_label != blank and director.system.url != blank %}
        <a class="director-focus__button" href="{{ director.system.url }}">
          <span>{{ section.settings.button_label | escape }}</span>
          <span class="director-focus__button-arrow" aria-hidden="true">&#x2197;&#xFE0E;</span>
        </a>
      {% endif %}
    </div>

    {% if portrait != blank %}
      <div class="director-focus__photo">
        {{
          portrait
          | image_url: width: 1000
          | image_tag:
            class: 'director-focus__image',
            widths: '400, 600, 800, 1000',
            sizes: '(min-width: 990px) 30vw, 80vw',
            alt: portrait_alt,
            loading: 'lazy'
        }}
      </div>
    {% endif %}
  </section>
{% elsif request.design_mode %}
  <section class="director-focus director-focus--empty">
    <p>Choose a director in the section settings.</p>
  </section>
{% endif %}

{% stylesheet %}
  .director-focus {
    --archive-ink: #191919;
    --archive-cream: #f5eedc;
    --archive-blue: #3155e8;
    --archive-red: #e94b35;
    --archive-lilac: #c6b9e6;

    display: grid;
    gap: 2rem;
    padding: clamp(3rem, 6vw, 6rem) clamp(1.5rem, 4vw, 3.75rem);
    color: var(--archive-ink);
    background: var(--archive-lilac);
  }

  .director-focus p {
    margin: 0;
  }

  .director-focus__number {
    color: var(--archive-blue);
    font-family: var(--font-heading--family);
    font-size: clamp(5rem, 12vw, 12rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
  }

  .director-focus__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .director-focus__label {
    font-family: var(--font-accent--family);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .director-focus__name {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: var(--font-heading--weight);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }

  .director-focus__name-first {
    text-transform: uppercase;
  }

  .director-focus__name-last {
    color: var(--archive-red);
    font-style: italic;
  }

  .director-focus__excerpt {
    max-width: 36ch;
    font-size: clamp(1.15rem, 1.6vw, 1.6rem);
    line-height: 1.3;
  }

  .director-focus__button {
    display: flex;
    align-items: stretch;
    width: fit-content;
    color: var(--archive-cream);
    background: var(--archive-ink);
    font-family: var(--font-body--family);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    border: 2px solid var(--archive-ink);
    box-shadow: 0.45rem 0.45rem 0 var(--archive-ink);
  }

  .director-focus__button span:first-child {
    padding: 1rem 1.25rem;
  }

  .director-focus__button-arrow {
    display: grid;
    width: 3.5rem;
    place-items: center;
    border-inline-start: 2px solid var(--archive-cream);
    font-size: 1.75rem;
    font-weight: 400;
  }

  /* Hover: the arrow cell turns yellow. Press: a small push down, like the add-to-cart button */
  .director-focus__button-arrow {
    transition: background-color var(--animation-speed) ease-out, color var(--animation-speed) ease-out;
  }

  .director-focus__button:is(:hover, :focus-visible) .director-focus__button-arrow {
    color: var(--archive-ink);
    background: #f2d46d;
  }

  @media (prefers-reduced-motion: no-preference) {
    .director-focus__button {
      transition: scale var(--animation-speed) ease-out, translate var(--animation-speed) ease-out;
    }

    .director-focus__button:active {
      scale: 0.99;
      translate: 0 1px;
    }
  }

  .director-focus__photo {
    justify-self: center;
    width: min(100%, 26rem);
    padding: 1rem 1rem 3.5rem;
    background: var(--archive-cream);
    border: 2px solid var(--archive-ink);
    box-shadow: 0.6rem 0.6rem 0 var(--archive-ink);
    transform: rotate(2deg);
  }

  .director-focus__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1);
  }

  .director-focus--empty {
    display: block;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    /* On wide screens the side padding grows so the content never exceeds 90rem;
       the lilac background still runs edge to edge */
    .director-focus {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 0.8fr);
      align-items: center;
      gap: clamp(2rem, 4vw, 4rem);
      padding-inline: max(clamp(1.5rem, 4vw, 3.75rem), calc((100% - 90rem) / 2));
    }

    .director-focus__number {
      align-self: start;
    }

    .director-focus__photo {
      justify-self: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Director focus",
  "settings": [
    {
      "type": "metaobject",
      "id": "director",
      "label": "Director",
      "metaobject_type": "directors"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "02"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Director focus / Vol. 07"
    },
    {
      "type": "range",
      "id": "excerpt_words",
      "label": "Biography length (words)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 20
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter the director archive"
    }
  ],
  "presets": [
    {
      "name": "Director focus"
    }
  ]
}
{% endschema %}
