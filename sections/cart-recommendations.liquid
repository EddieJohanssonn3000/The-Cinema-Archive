{% comment %}
  "You may also like" on the cart page: film cards from a collection, leaving out films that
  are already in the cart and films that are sold out.

  Liquid's contains only works reliably on strings, so the product ids in the cart are joined
  into one string like ",123,456," and each film is looked up as ",123,".

  The list is built when the page loads. Removing a film from the cart updates the cart but
  not this section, so that film comes back here on the next page load.
{% endcomment %}

{% liquid
  # Fall back to all products when no collection is picked in the Theme Editor
  assign film_collection = section.settings.collection | default: collections.all
  assign max_films = section.settings.max_films

  assign cart_ids = cart.items | map: 'product_id' | join: ','
  assign cart_ids = ',' | append: cart_ids | append: ','

  assign film_count = 0
%}

{% capture film_cards %}
  {% for product in film_collection.products %}
    {% liquid
      assign product_key = ',' | append: product.id | append: ','
      if cart_ids contains product_key or product.available == false
        continue
      endif
    %}
    <li class="cart-recommendations__item">
      {% render 'film-card', product: product, sizes: '(min-width: 750px) 25vw, 45vw' %}
    </li>
    {% liquid
      assign film_count = film_count | plus: 1
      if film_count >= max_films
        break
      endif
    %}
  {% endfor %}
{% endcapture %}

{% if film_count > 0 %}
  <div class="section section--page-width">
    <div class="cart-recommendations">
      <div class="cart-recommendations__header">
        {% if section.settings.heading != blank %}
          <h2 class="cart-recommendations__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.link_label != blank %}
          <a class="cart-recommendations__link" href="{{ film_collection.url }}">
            {{- section.settings.link_label | escape -}}
          </a>
        {% endif %}
      </div>

      <ul class="cart-recommendations__grid" role="list">
        {{ film_cards }}
      </ul>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .cart-recommendations {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    color: #191919;
  }

  .cart-recommendations__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
    padding-block-start: clamp(1.5rem, 3vw, 2.5rem);
    border-block-start: 2px solid #191919;
  }

  .cart-recommendations__heading {
    margin: 0;
    color: #191919;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3.5vw, 3.25rem);
    font-weight: var(--font-heading--weight);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .cart-recommendations__link {
    color: #191919;
    font-family: var(--font-accent--family);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-underline-offset: 0.2em;
  }

  .cart-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-recommendations__item {
    min-width: 0;
  }

  /* Mobile: one swipeable row, same approach as the director filmography */
  @media screen and (max-width: 749px) {
    .cart-recommendations__grid {
      display: flex;
      gap: 1rem;
      padding-block-end: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    .cart-recommendations__item {
      flex: 0 0 45%;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart recommendations",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "max_films",
      "label": "Number of films",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Cart recommendations"
    }
  ]
}
{% endschema %}
