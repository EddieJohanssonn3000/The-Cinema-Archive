{% doc %}
  Renders a film's director, format, release (year · runtime) and condition from product
  metafields as a list with a rule between each row.
  Renders nothing when none of the metafields have a value.

  @param {product} product - Product object

  @example
  {% render 'film-details', product: closest.product %}
{% enddoc %}

{% liquid
  # The director metafield references a Director metaobject; its fields also need .value
  assign director = product.metafields.custom.director.value
  assign director_name = director.name.value
  assign film_format = product.metafields.custom.format.value
  assign film_condition = product.metafields.custom.condition.value
  assign release_year = product.metafields.custom.release_year.value
  assign runtime = product.metafields.custom.runtime.value
%}

{% if director_name != blank or film_format != blank or film_condition != blank or release_year != blank or runtime != blank %}
  <dl class="film-details">
    {% if director_name != blank %}
      <div class="film-details__item">
        <dt class="film-details__label">Director</dt>
        <dd class="film-details__value">
          {%- if director.system.url != blank -%}
            <a href="{{ director.system.url }}">{{ director_name | escape }}</a>
          {%- else -%}
            {{ director_name | escape }}
          {%- endif -%}
        </dd>
      </div>
    {% endif %}

    {% if film_format != blank %}
      <div class="film-details__item">
        <dt class="film-details__label">Format</dt>
        <dd class="film-details__value">{{ film_format | escape }}</dd>
      </div>
    {% endif %}

    {% if release_year != blank or runtime != blank %}
      <div class="film-details__item">
        <dt class="film-details__label">Release</dt>
        <dd class="film-details__value">
          {{- release_year -}}
          {%- if release_year != blank and runtime != blank %} · {% endif -%}
          {%- if runtime != blank -%}
            {% liquid
              # Runtime is stored as minutes, e.g. 99 is shown as "1 h 39 min"
              assign runtime_hours = runtime | divided_by: 60
              assign runtime_minutes = runtime | modulo: 60
            %}
            <time datetime="PT{{ runtime }}M">
              {%- if runtime_hours > 0 -%}
                {{ runtime_hours }} h
              {%- endif -%}
              {%- if runtime_hours > 0 and runtime_minutes > 0 %} {% endif -%}
              {%- if runtime_minutes > 0 -%}
                {{ runtime_minutes }} min
              {%- endif -%}
            </time>
          {%- endif -%}
        </dd>
      </div>
    {% endif %}

    {% if film_condition != blank %}
      <div class="film-details__item">
        <dt class="film-details__label">Condition</dt>
        <dd class="film-details__value">{{ film_condition | escape }}</dd>
      </div>
    {% endif %}
  </dl>
{% endif %}

{% stylesheet %}
  .film-details {
    --archive-ink: #191919;

    margin: 0;
    color: var(--archive-ink);
    border-block-start: 2px solid var(--archive-ink);
  }

  .film-details__item {
    display: grid;
    grid-template-columns: minmax(6rem, 1fr) minmax(0, 2fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.1rem;
    border-block-end: 1px solid var(--archive-ink);
  }

  .film-details__label {
    font-family: var(--font-accent--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .film-details__value {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    line-height: 1.25;
  }

  .film-details__value a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .film-details__value a:hover,
  .film-details__value a:focus-visible {
    text-decoration-thickness: 2px;
  }
{% endstylesheet %}
