{% doc %}
  Archive note: a short editorial quote between two rules, with a small label to the left.
  Used by sections/archive-note.liquid and sections/main-directors.liquid.
  Renders nothing when both the label and the quote are empty.

  @param {string} [label] - Small label, e.g. "Archive note 04"
  @param {string} [quote] - The quote text

  @example
  {% render 'archive-note', label: section.settings.label, quote: section.settings.quote %}
{% enddoc %}

{% if label != blank or quote != blank %}
  <div class="archive-note__inner">
    {% if label != blank %}
      <p class="archive-note__label">{{ label | escape }}</p>
    {% endif %}

    {% if quote != blank %}
      <p class="archive-note__quote">{{ quote | escape }}</p>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .archive-note__inner {
    display: grid;
    gap: 1rem;
    max-width: 64rem;
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    color: #191919;
    border-block: 2px solid #191919;
  }

  .archive-note__inner p {
    margin: 0;
  }

  .archive-note__label {
    font-family: var(--font-accent--family);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .archive-note__quote {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.15;
  }

  @media screen and (min-width: 750px) {
    .archive-note__inner {
      grid-template-columns: minmax(8rem, 1fr) minmax(0, 3.2fr);
      gap: 2rem;
    }

    .archive-note__label {
      padding-block-start: 0.5rem;
    }
  }
{% endstylesheet %}
